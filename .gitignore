# --- Your media and everything generated from it (large, personal) ---
media/
input/*
!input/.gitkeep
frames/*
!frames/.gitkeep
reconstruction/*
!reconstruction/.gitkeep
output/*
!output/.gitkeep
renders/*
!renders/.gitkeep
camera/*
!camera/.gitkeep
!camera/example_path.json

